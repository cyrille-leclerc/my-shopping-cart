#!/usr/bin/env bash
set -euo pipefail

# Push images (you'll need to push manually since compose build doesn't push)
GITHUB_USER="cyrille-leclerc"
REGISTRY="ghcr.io/${GITHUB_USER}"

active_user=$(gh api user -q .login)
if [[ "${active_user}" != "${GITHUB_USER}" ]]; then
    gh auth switch --hostname github.com --user "${GITHUB_USER}"
fi
if ! gh auth status --hostname github.com 2>&1 | grep -A5 "account ${GITHUB_USER}" | grep -q "write:packages"; then
    gh auth refresh --hostname github.com --scopes write:packages
fi
GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token)}"
echo "${GITHUB_TOKEN}" | docker login ghcr.io -u "${GITHUB_USER}" --password-stdin

languages=("java" "nodejs" "python")
pushed_images=()

for language in "${languages[@]}"; do
    cd "$language"
    version=$(cat version.txt)
    image="${REGISTRY}/dd-autoinstrumentation-${language}:${version}"
    echo "Building ${image}..."
    docker buildx build \
        --platform linux/amd64,linux/arm64 \
        --build-arg version="${version}" \
        --tag "${image}" \
        --push \
        .
    pushed_images+=("${image}")
    cd ..
done

echo "All autoinstrumentation images built and pushed!"
echo "Pushed images:"
for image in "${pushed_images[@]}"; do
    echo "  ${image}"
done